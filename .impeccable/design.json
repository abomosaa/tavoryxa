  "narrative": {
    "northStar": "The Warm Stationery Shelf",
    "overview": "Warm paper, paprika ink and generated concept photography lead the collection and product pages. Preserved SVG artwork is an honest image-failure fallback. Gallery, saved objects, bounded quantities and immutable order details keep shopping tasks clear.",
    "keyCharacteristics": [
      "Warm paper and restrained paprika contrast.",
      "Consistent photographic desk materials with generous breathing room.",
      "Arabic-first UI and English editorial serif."
    ],
    "rules": [
      {
        "name": "The Material Field Rule",
        "body": "Give product illustrations calm tonal fields rather than decorative interface shadows.",
        "section": "neutral"
      },
      {
        "name": "The Language Role Rule",
        "body": "Keep the serif in English editorial headings while Arabic and operational controls use their established sans families.",
        "section": "typography"
      },
      {
        "name": "The Direction Rule",
        "body": "Arabic RTL and English LTR share logical spacing and start/end alignment; illustrated still-life compositions retain their intended object orientation.",
