      }
    ],
    "dos": [
      "Preserve Arabic RTL and complete English layouts.",
      "Label generated imagery and fallback honestly.",
      "Keep media sizing separate from action icons.",
      "Preserve stored order prices and local/cloud boundaries."
    ],
    "donts": [
      "Do not invent inventory, reviews or fulfillment.",
      "Do not change old order totals when re-adding."
