{
  "name": "tavoryxa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write src qa/*.cjs *.json *.jsonc *.ts *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src qa/*.cjs *.json *.jsonc *.ts *.html *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.7",
    "@fontsource/noto-sans-arabic": "5.2.7",
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
